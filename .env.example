# ========================================================
# DailyWork Real OTP & SMS Gateway Configuration
# ========================================================

# ========================================================
# Option 1: Brevo (Recommended for SMS & Email OTP)
# ========================================================
# 1. Sign up / Log in at: https://www.brevo.com
# 2. Go to: Top right profile -> "SMTP & API" -> "API Keys"
# 3. Click "+ Generate a new API key", name it "DailyWork", and copy the key (starts with xkeysib-...)
# 4. Paste your key below:
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMS_SENDER=DailyWork

# Optional Brevo Email delivery:
# Brevo gives 300 free emails/day with ZERO telecom/DLT restrictions.
# To also receive the OTP in your email inbox, configure your email below:
# BREVO_EMAIL_TO=your_email@gmail.com
# BREVO_SENDER_EMAIL=your_verified_brevo_email@gmail.com


# ========================================================
# Option 2: Fast2SMS (Indian Gateway)
# ========================================================
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# FAST2SMS_OTP_ID=your_smart_otp_template_id_here


# ========================================================
# Option 3: 2Factor.in (Indian Gateway)
# ========================================================
# TWOFACTOR_API_KEY=your_2factor_api_key_here


# ========================================================
# Option 4: Twilio (Global SMS Gateway)
# ========================================================
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
